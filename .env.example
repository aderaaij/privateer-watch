# privateer-watch configuration
#
# Copy this file to .env and fill in your values:  cp .env.example .env
# Everything host-specific lives here — no tracked file should need editing.
# The .env file holds credentials and is gitignored; keep it out of version
# control and back it up (see scripts/backup_offbox.sh).

## Docker Compose
# Project name — prefixes networks/volumes compose creates for this stack
COMPOSE_PROJECT_NAME=privateer-watch

## Paths
# Stack root: where this repository lives. Every container keeps its config
# in a subdirectory here (radarr/, sonarr/, gluetun/, ...).
DOCKERCONFDIR=/volume1/docker/appdata
# Media library + downloads root. Uses the TRaSH-guides hardlink-friendly
# layout: media/, torrents/ and usenet/ all under one mount.
# See https://trash-guides.info/Hardlinks/
DOCKERSTORAGEDIR=/volume1/data

## Host
# LAN IP of the machine running the stack — the MCP server and dashboard use
# it to reach the other services
NAS_HOST=192.168.1.100
# User/group the containers run as. Find yours over SSH with:  id $USER
PUID=1000
PGID=1000
# Your timezone (TZ database name)
TZ=Europe/Amsterdam

## Container log rotation
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

## Service URLs (optional)
# Where Recyclarr and the space-saver scripts reach Radarr/Sonarr. Defaults
# to container-name DNS (http://radarr:7878 / http://sonarr:8989) inside
# compose and http://localhost inside scripts. Set to http://<NAS_HOST>:<port>
# if those defaults don't fit your network setup.
#RADARR_URL=http://192.168.1.100:7878
#SONARR_URL=http://192.168.1.100:8989

## VPN — Privado account (used by the API automation for server rotation)
# Any other WireGuard provider works too: skip these and use the manual
# config flow instead (wireguard_configs/ + scripts/parse_wireguard_conf.sh).
PRIVADO_USERNAME=your_vpn_username
PRIVADO_PASSWORD=your_vpn_password

## WireGuard configuration
# Initial values come from your provider's WireGuard .conf file; after setup
# the automation scripts rewrite these on every server rotation.
# Synology note: if gluetun fails with "Failed to open '/dev/net/tun'", set
# up the tun.service from the TRaSH guides first:
# https://trash-guides.info/Hardlinks/How-to-setup-for/Synology/
WIREGUARD_ENDPOINT_IP="0.0.0.0"
WIREGUARD_ENDPOINT_PORT="51820"
WIREGUARD_PUBLIC_KEY="replace_with_server_public_key"
WIREGUARD_PRIVATE_KEY="replace_with_your_private_key"
WIREGUARD_ADDRESSES="10.0.0.1/32"

## WireGuard automation settings
# Server preferences for automatic selection (comma-separated)
WIREGUARD_PREFERRED_COUNTRIES="NL,DE,UK,FR"
WIREGUARD_PREFERRED_CITIES="Amsterdam,Berlin,London,Paris"

# Time-based rotation (rotation on VPN failure happens regardless)
WIREGUARD_AUTO_ROTATION="false"  # Rotate servers on a schedule
WIREGUARD_ROTATION_INTERVAL="24" # Hours between scheduled rotations

# Auto-recovery: the monitor restarts a failed VPN, then switches servers
# once the restart budget is exhausted
WIREGUARD_AUTO_RECOVERY="true"      # Enable automatic recovery on VPN failure
WIREGUARD_MAX_RESTART_ATTEMPTS="3"  # Restarts per day before switching servers
WIREGUARD_AUTO_SERVER_SWITCH="true" # Allow switching servers on failure

# Performance thresholds for server selection
WIREGUARD_MAX_LATENCY="150"  # Maximum acceptable latency in milliseconds
WIREGUARD_MIN_SPEED="50"     # Minimum acceptable speed in Mbps (future use)

## Pullio — container auto-updates
# Setup: https://trash-guides.info/Hardlinks/How-to-setup-for/Synology/#pullio-auto-update-docker-compose-the-correct-way
PULLIO_UPDATE=true
# Discord notifications for updates and VPN alerts; leaving the webhook empty
# disables them. See docs/discord-webhook-setup.md
PULLIO_NOTIFY=true
PULLIO_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

## Service API keys (MCP server, dashboard, Recyclarr, space-saver scripts)
# Copy each key from the service's web UI: Settings -> General -> API Key.
# qBittorrent credentials are the web UI login.
MCP_SONARR_API_KEY=your_sonarr_api_key
MCP_RADARR_API_KEY=your_radarr_api_key
MCP_SABNZBD_API_KEY=your_sabnzbd_api_key
MCP_PROWLARR_API_KEY=your_prowlarr_api_key
MCP_READARR_API_KEY=your_readarr_api_key
MCP_BAZARR_API_KEY=your_bazarr_api_key
MCP_SEERR_API_KEY=your_seerr_api_key
MCP_QBITTORRENT_USERNAME=your_qbittorrent_username
MCP_QBITTORRENT_PASSWORD=your_qbittorrent_password

## Off-box backup (scripts/backup_offbox.sh — optional)
# SSH destination for the nightly .env + *arr backup tarball.
#BACKUP_REMOTE_HOST=backup-host.example.com
#BACKUP_REMOTE_USER=your_ssh_user
#BACKUP_REMOTE_PORT=22
#BACKUP_REMOTE_DIR=backups/mediastack
#BACKUP_KEEP=14
