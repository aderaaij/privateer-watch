## Here you edit/update your settings that will be used for your docker-compose
## This will only work if you follow exactly the path structure in the Guide !!!
COMPOSE_PROJECT_NAME=htpc-download-box

## Global Settings
# <change "/volume1/docker/appdata" with the path your configs will be>
DOCKERCONFDIR=/volume1/docker/appdata
# <change "/volume1/data" with the path where your library + torrent/usenet downloads both are>
DOCKERSTORAGEDIR=/volume1/data
# <you must find out your PUID/PGID through SSH, run in terminal: id $user. If needed, change $user to the user you created.>
PUID=1000
PGID=1000
# <change to your timezone>
TZ=Europe/Amsterdam
# Dockerlogging and max size
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

# <LAN IP of your NAS - used by the MCP server and dashboard to reach the other services>
NAS_HOST=192.168.1.100

# Where Recyclarr and the space-saver scripts reach Radarr/Sonarr.
# Optional: defaults to container-name DNS (http://radarr:7878 / http://sonarr:8989)
# inside compose and http://localhost inside scripts. Set to http://<NAS_HOST>:<port>
# if those defaults don't fit your network setup.
#RADARR_URL=http://192.168.1.100:7878
#SONARR_URL=http://192.168.1.100:8989

## VPN - PRIVADO (or your VPN provider)
PRIVADO_USERNAME=your_vpn_username
PRIVADO_PASSWORD=your_vpn_password

# Wireguard Configuration
# These values come from your VPN provider's WireGuard config file
WIREGUARD_ENDPOINT_IP="0.0.0.0"
WIREGUARD_ENDPOINT_PORT="51820"
WIREGUARD_PUBLIC_KEY="replace_with_server_public_key"
WIREGUARD_PRIVATE_KEY="replace_with_your_private_key"
WIREGUARD_ADDRESSES="10.0.0.1/32"

## WireGuard Automation Settings
# Server preferences for automatic selection (comma-separated)
WIREGUARD_PREFERRED_COUNTRIES="NL,DE,UK,FR"
WIREGUARD_PREFERRED_CITIES="Amsterdam,Berlin,London,Paris"

# Automatic rotation settings
WIREGUARD_AUTO_ROTATION="false"  # Enable automatic server rotation
WIREGUARD_ROTATION_INTERVAL="24"  # Hours between automatic rotations

# Auto-recovery settings
WIREGUARD_AUTO_RECOVERY="true"   # Enable automatic recovery on VPN failure
WIREGUARD_MAX_RESTART_ATTEMPTS="3"  # Max restarts per day before switching servers
WIREGUARD_AUTO_SERVER_SWITCH="true"  # Enable automatic server switching on failure

# Performance thresholds
WIREGUARD_MAX_LATENCY="150"  # Maximum acceptable latency in milliseconds
WIREGUARD_MIN_SPEED="50"     # Minimum acceptable speed in Mbps (future use)

## PLEX Section

# Go to plex.tv/claim and login with your account,
# copy the claim code and add it "claim-xxxxxxxxxxxxxxxxxxxx".
# When starting the new plex server for the first time, the server will be added to your account.
PLEX_CLAIM_TOKEN=claim-xxxxxxxxxxxxxxxxxxxx

# If you are a Plex Pass subscriber, you can enable the install of beta builds <true|false>
PLEX_BETA_INSTALL=false

# Replace IP in http://192.168.x.x:32400 with the IP of your server/nas, don't change the port! Unless you specifically changed the default port.
# This is useful to aid your local clients in discovering your plex server when running in the bridge network mode.
PLEX_ADVERTISE_URL="http://192.168.1.100:32400"


## VPN Settings (Only needed if you want to run a VPN Container)

# If you are getting a "Failed to open '/dev/net/tun'" error, run the commands below.
# 1 - sudo curl -sL https://raw.githubusercontent.com/TRaSH-/Guides-Synology-Templates/main/script/tun.service -o "/etc/systemd/system/tun.service"
# 2 - sudo systemctl enable /etc/systemd/system/tun.service
# 3 - sudo systemctl start tun
# Check if running with - sudo systemctl status tun

# <lan ipv4 network>/<cidr notation>
LAN_NETWORK=192.168.1.0/24

## qbittorrent
# ENABLE VPN=<true|false>
VPN_ENABLED=false

# ENABLE PRIVOXY=<true|false>
QBITTORRENT_ENABLE_PRIVOXY=false

# qBittorrent (web ui)
QBITTORRENT_WEBUI_PORT=8080

# Privoxy Port
QBITTORRENT_PRIVOXY_PORT=8118

#Pick your vpn provider options are generic|pia|proton
VPN_PROVIDER=generic

#Auto port forward rules. <true|false>. For PIA or Proton, set true. Torguard is false.
PORT_FORWARD=false

## Pullio - Auto update docker-compose the correct way.
# Setup instructions https://trash-guides.info/Hardlinks/How-to-setup-for/Synology/#pullio-auto-update-docker-compose-the-correct-way
# If you want your containers to be updated
PULLIO_UPDATE=true
# If you want a notification when there's a update, only discord webhook notifications is supported.
# Adding no discord webhook will disable the notifications!!!
# check for more info https://hotio.dev/pullio/ and how to add the webhook.
PULLIO_NOTIFY=true
PULLIO_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

## Notifiarr
# Hostname is used to identify your host and can be set to anything you like.
HOSTNAME=YourNASHostname

## Service API keys (MCP server, dashboard, Recyclarr, space-saver scripts)
# Copy each key from the service's web UI: Settings -> General -> API Key.
# qBittorrent credentials are the web UI login.
MCP_SONARR_API_KEY=your_sonarr_api_key
MCP_RADARR_API_KEY=your_radarr_api_key
MCP_SABNZBD_API_KEY=your_sabnzbd_api_key
MCP_PROWLARR_API_KEY=your_prowlarr_api_key
MCP_READARR_API_KEY=your_readarr_api_key
MCP_BAZARR_API_KEY=your_bazarr_api_key
MCP_SEERR_API_KEY=your_seerr_api_key
MCP_QBITTORRENT_USERNAME=your_qbittorrent_username
MCP_QBITTORRENT_PASSWORD=your_qbittorrent_password

## Off-box backup (scripts/backup_offbox.sh - optional)
# SSH destination for the nightly .env + *arr backup tarball.
#BACKUP_REMOTE_HOST=backup-host.example.com
#BACKUP_REMOTE_USER=your_ssh_user
#BACKUP_REMOTE_PORT=22
#BACKUP_REMOTE_DIR=backups/mediastack
#BACKUP_KEEP=14